# Odak Mentor Uygulaması - Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri güncelleyin

# PostgreSQL Veritabanı Konfigürasyonu
DB_HOST=192.168.1.100
DB_PORT=5432
DB_NAME=odakmentor_db
DB_USER=odakmentor
DB_PASSWORD=your_secure_password

# Uygulama Konfigürasyonu
NODE_ENV=development
PORT=3000

# JWT Secret (Güçlü bir secret kullanın)
JWT_SECRET=your_jwt_secret_key_here

# CORS Ayarları
CORS_ORIGIN=http://localhost:3000

# Log Seviyesi
LOG_LEVEL=info

# Dosya Yükleme
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Email Konfigürasyonu (Opsiyonel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Redis Konfigürasyonu (Opsiyonel)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Monitoring (Opsiyonel)
ENABLE_METRICS=true
METRICS_PORT=9090

# Admin kullanıcı bootstrap (sunucu yeniden başlatılınca admin oluşturur)
ADMIN_BOOTSTRAP=0
ADMIN_EMAIL=admin@odakmentor.com
ADMIN_PASSWORD=admin123

# WebRTC TURN/STUN (front-end için EXPO public)
EXPO_PUBLIC_TURN_HOST=odakmentor.com
EXPO_PUBLIC_TURN_USER=odakmentor
EXPO_PUBLIC_TURN_PASS=StrongTurnPass123