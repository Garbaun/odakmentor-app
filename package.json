{
  "name": "mentor-ai",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --web",
    "dev": "expo start --web",
    "dev:fast": "npm run web:build && npm run web:serve",
    "web": "expo start --web",
    "web:build": "expo export -p web --output-dir docs --clear && node scripts/patch-web-index.js",
    "web:serve": "npx serve docs",
    "web:deploy": "npm run web:build && npx gh-pages -d docs -b gh-pages",
    "web:publish-root": "npm run web:build && node scripts/publish-to-root.js",
    "lint": "expo lint",
    "init-db": "node scripts/initDatabase.js",
    "db:init": "npm run init-db init",
    "db:cleanup": "npm run init-db cleanup",
    "db:reset": "npm run init-db reset"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/elements": "^1.3.4",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/stack": "^6.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.5",
    "bcryptjs": "^3.0.2",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.8",
    "expo-blur": "~15.0.7",
    "expo-constants": "~18.0.8",
    "expo-font": "~14.0.8",
    "expo-image": "~3.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-router": "^3.5.24",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.7",
    "firebase": "^11.10.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "~0.76.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "tslib": "2.6.2",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@types/react": "~18.3.4",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "gh-pages": "^6.3.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "tslib": "2.6.2"
  }
}
